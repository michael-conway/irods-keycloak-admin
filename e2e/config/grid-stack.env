# Source this file when running the same e2e tests against irods-grid-stack.
# The endpoint names and host ports match e2e/config/internal.env.
IRODS_KC_E2E_ENABLED=1
IRODS_KC_E2E_TARGET=grid-stack

IRODS_KC_E2E_IRODS_PROVIDER_HOST=127.0.0.1
IRODS_KC_E2E_IRODS_PROVIDER_PORT=1247
IRODS_KC_E2E_IRODS_ZONE=tempZone
IRODS_KC_E2E_IRODS_ADMIN_USER=rods
IRODS_KC_E2E_IRODS_ADMIN_PASSWORD=rods
IRODS_KC_E2E_IRODS_PROVIDER_RESOURCE=providerResc
IRODS_KC_E2E_IRODS_PRIMARY_TEST_USER=test1
IRODS_KC_E2E_IRODS_PRIMARY_TEST_PASSWORD=test
IRODS_KC_E2E_IRODS_SECONDARY_TEST_USER=test2
IRODS_KC_E2E_IRODS_SECONDARY_TEST_PASSWORD=test

IRODS_KC_E2E_REST_PROVIDER_BASE_URL=http://127.0.0.1:8080
IRODS_KC_E2E_REST_RESOURCE_BASE_URL=http://127.0.0.1:8082

IRODS_KC_E2E_KEYCLOAK_BASE_URL=https://127.0.0.1:8443
IRODS_KC_E2E_KEYCLOAK_MANAGEMENT_URL=http://127.0.0.1:19090
IRODS_KC_E2E_KEYCLOAK_REALM=drs
IRODS_KC_E2E_KEYCLOAK_ADMIN_USER=admin
IRODS_KC_E2E_KEYCLOAK_ADMIN_PASSWORD=admin
IRODS_KC_E2E_KEYCLOAK_ADMIN_API_CLIENT_ID=irods-kc-admin-api
IRODS_KC_E2E_KEYCLOAK_ADMIN_API_CLIENT_SECRET=irods-kc-admin-api-secret
IRODS_KC_E2E_KEYCLOAK_ADMIN_CLI_CLIENT_ID=irods-kc-admin-cli
IRODS_KC_E2E_KEYCLOAK_ADMIN_CLI_CLIENT_SECRET=irods-kc-admin-cli-secret
IRODS_KC_E2E_KEYCLOAK_INSECURE_SKIP_VERIFY=true
IRODS_KC_E2E_KEYCLOAK_MIRROR_ROOT=/irods

IRODS_KC_E2E_FIXTURE_GROUPS=project-alpha,project-beta,irods-admins
