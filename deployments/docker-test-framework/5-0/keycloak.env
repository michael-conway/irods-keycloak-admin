# Database settings for the disposable compose stack.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/KEYCLOAK
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=testpassword
KC_HOSTNAME=localhost

# Keycloak admin console bootstrap user.
KEYCLOAK_ADMIN=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Fixture realm/client values for local tests.
KC_TEST_REALM=irods
KC_ADMIN_API_CLIENT_ID=irods-kc-admin-api
KC_ADMIN_API_CLIENT_SECRET=irods-kc-admin-api-secret
KC_ADMIN_CLI_CLIENT_ID=irods-kc-admin-cli
KC_ADMIN_CLI_CLIENT_SECRET=irods-kc-admin-cli-secret
